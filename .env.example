# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ga_con_counsel

# Server
PORT=5000

# Session (generate a random secret: openssl rand -base64 32)
SESSION_SECRET=your-session-secret-here

# Replit Auth (required for production authentication)
ISSUER_URL=https://replit.com/oidc
REPL_ID=your-repl-id

# OpenAI (required for AI drafting feature)
AI_INTEGRATIONS_OPENAI_API_KEY=your-openai-api-key
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
